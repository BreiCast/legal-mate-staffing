# PUBLIC SITE IDENTITY — set the approved canonical HTTPS origin before launch.
# An unset domain keeps robots/meta noindex enabled; localhost is only a fallback.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=info@legalmatestaffing.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_BUSINESS_LOCATION=

# BOOKING — full HTTPS link to the actual scheduling provider; blank hides CTAs.
NEXT_PUBLIC_BOOKING_URL=

# SERVER-ONLY LEAD DELIVERY — verify the sender domain in Resend first.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Legal Mate Staffing <info@legalmatestaffing.com>"
LEAD_TO_EMAIL=info@legalmatestaffing.com
# Generate: openssl rand -hex 32
LEAD_HASH_SECRET=

# REQUIRED IN PRODUCTION — shared rate limits and 24-hour retry metadata.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Non-Vercel only: a header your trusted reverse proxy OVERWRITES with client IP.
# Leave blank if no trustworthy proxy header exists (shared unknown-IP bucket).
LEAD_TRUSTED_IP_HEADER=

# OPTIONAL ANALYTICS — GA4 measurement ID; consent required before loading.
# Disable enhanced measurement's form interactions/page-history tracking in GA4.
NEXT_PUBLIC_GA_ID=
